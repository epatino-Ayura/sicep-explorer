do_fin":{"valor":"2041-12-31","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":4}},"horario":{"valor":"Horas 7 a 18, curva solar","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":4}},"tipo_curva":"variable","tipo_contrato":{"valor":"Pague lo contratado.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":4}},"cantidad_resumen":{"valor":"1.800.000 MWh en total para todo el período 2027-2041; el pliego no cita un total anual (el detalle por mes está en el Anexo 1, que no está en el texto).","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":4}},"mwh_anual_citado":null,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Se ofrece un solo porcentaje por año, sin porcentaje mínimo; precios distintos por mes permitidos.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":7}}}],"precio":{"tope_o_reserva":{"valor":"Neu presenta un precio de reserva por mes y producto, cuyo valor no aparece en el pliego. El precio ofertado no puede superar en 10 % el precio de reserva del mismo mes, y el precio promedio ponderado ofertado debe ser menor o igual al de reserva.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":10}},"moneda_base":{"valor":"Pesos colombianos por kWh, con dos decimales, en pesos constantes de enero de 2025.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":7}},"indexacion":{"indice":{"valor":"IPP (Índice de Precios al Productor), oferta interna, valor provisional publicado por el DANE.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":7}},"periodicidad":{"valor":"Mensual, con el IPP provisional publicado los primeros días del mes siguiente.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":16}},"base":{"valor":"Enero de 2025, versión provisional.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":2}}}},"garantias":{"seriedad_oferta":{"valor":"Pagaré en blanco con carta de instrucciones (Anexo 6) por el 3 % del valor de la oferta; solo se ejecuta si el oferente adjudicado no firma el contrato dentro del plazo por causa suya. La oferta debe mantenerse válida 60 días calendario desde el cierre.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":30}},"cumplimiento_contrato":{"valor":"Pagaré en blanco con carta de instrucciones (Anexo 4), sin monto fijado, a entregar dentro de los 5 días hábiles siguientes a la firma del contrato.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":13}},"pago_comprador":{"valor":"Pagaré en blanco del comprador y garantía bancaria por 3 veces el promedio mensual de la energía adjudicada en el año, con vigencia anual y entrega 30 días calendario antes del inicio del suministro. Se puede cambiar por póliza solo si el vendedor acepta.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":12}}},"criterio_adjudicacion":{"valor":"Se adjudican las ofertas habilitadas que maximicen la cantidad de energía adjudicada al menor precio posible, con cada producto evaluado por separado, con el precio promedio ponderado dentro del de reserva.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":10}},"penalidades":[{"valor":"Cláusula penal del 30 % del valor del contrato, calculado sobre las cantidades no suministradas y los precios adjudicados, si hay terminación unilateral por incumplimiento grave o incumplimiento definitivo; la parte afectada puede cobrar además los perjuicios que excedan la pena.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":21}},{"valor":"Si el adjudicatario no firma el contrato en el plazo, Neu puede ejecutar el pagaré de seriedad y reclamar perjuicios no cubiertos.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":12}},{"valor":"La parte cumplida puede terminar el contrato si la incumplida no resuelve el incumplimiento en 5 días hábiles tras la notificación.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":21}},{"valor":"Intereses de mora a la tasa máxima legal si el comprador no paga en los plazos pactados.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":19}}],"fncer":{"exclusivo":null,"requisitos":{"valor":null,"fuente":null}},"condiciones_especiales":[{"valor":"Las ofertas se presentan como porcentaje de la curva requerida por Neu; no se aceptan cantidades superiores al 100 % de lo requerido en el Anexo 1.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":8}},{"valor":"Adjudicación parcial permitida salvo que el oferente indique lo contrario; se pueden presentar varias ofertas por producto.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":7}},{"valor":"Desempate: primero menor costo de adjudicación, luego prorrata de las cantidades ofrecidas; las cifras decimales se redondean a la parte entera.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":10}},{"valor":"El impuesto de timbre (Decreto 175 de 2025) lo asume el vendedor y va incluido en el precio; nuevos impuestos se trasladan al precio.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":13}},{"valor":"El precio debe incluir todos los cargos del oferente hasta la frontera comercial de Neu con el STN a 230 kV.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":8}},{"valor":"Los oferentes deben ser generadores o comercializadores inscritos en el SIC, con existencia de la sociedad de al menos un año más que el plazo del contrato.","fuente":{"archivo":"PLIEGO DE CONDICIONES DEFINITIVOS CP-NEUC2025-001.pdf","pagina":5}}],"resumen_ejecutivo":"Neu Energy S.A.S. E.S.P. convoca la compra de energía para su mercado regulado en seis productos, en la modalidad pague lo contratado. Los productos 1 a 5 son anuales de 24 horas para 2027-2031, de unos 117.734 a 118.057 MWh cada uno, y el producto 6 es de 1.800.000 MWh en la franja de horas 7 a 18 con curva solar, de 2027 a 2041. Los precios se ofertan en pesos constantes de enero de 2025 y se indexan mensualmente con el IPP oferta interna. Se adjudica por productos independientes contra un precio de reserva de Neu que no se publica. Los oferentes dan pagarés en blanco como garantías, con una cláusula penal del 30 %."},"modelo":"claude-code","alertas":[]}