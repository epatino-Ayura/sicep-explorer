19.4563,34.2876,59.576,76.2105,85.4047,88.5836,87.7453,82.975,74.0969,58.5183,33.5722,77.8251,77.8251,77.8251,77.8251,77.8251,77.8251,77.8251]}},"descartes":[]}},"descartes_generales":[]},"resumen":{"convocatoria":"CP-CSIC2025-002","comprador":{"valor":"AIR-E S.A.S. E.S.P. (Intervenida), Barranquilla; toma de posesión con fines liquidatorios por la SSPD y administración temporal","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":2}},"objeto":{"valor":"Suministro de energía eléctrica y potencia asociada para atender parte de la demanda del mercado regulado de Air-e entre el 2026-01-01 y el 2040-12-31, con uno o varios oferentes, hasta el monto y precio de la Oferta de Reserva.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":3}},"mercado":{"valor":"Mercado regulado; fronteras de los departamentos de Atlántico, Guajira y Magdalena. Convocatoria bajo la Resolución CREG 130 de 2019.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":13}},"fechas":{"publicacion":{"valor":"2025-04-24","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":6}},"consultas_hasta":{"valor":"2025-04-30 a las 12:00 pm","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":14}},"entrega_ofertas":{"valor":"2025-05-16 hasta las 23:59 (ofertas y requisitos habilitantes); la oferta reserva de Air-e también se registra ese día","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":15}},"adjudicacion":{"valor":"Audiencia pública de adjudicación: el cronograma indica 2025-05-29 a las 15:00, pero el numeral 6 indica 2025-06-03 a las 15:00 (presencial en Barranquilla y virtual); publicación de resultados a las 18:00 del mismo día","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":20}},"firma_contrato":{"valor":"Fecha límite de legalización de contratos 2025-06-18; envío de información al ASIC hasta 2025-06-20; registro de contratos hasta 2025-06-25","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":6}}},"productos":[{"nombre":"Producto 1","periodo_inicio":{"valor":"2026-01-01","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":11}},"periodo_fin":{"valor":"2029-12-31","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":11}},"horario":{"valor":"24 horas, todos los días","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":11}},"tipo_curva":"plana_24h","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":11}},"cantidad_resumen":{"valor":"10,710 GWh-producto en 2026-2029 (total 10,709,934,655 kWh); cantidades mensuales por año en el cuadro 4.1. Varía por año, sin total anual único.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":27}},"mwh_anual_citado":null,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Oferta mensual, porcentaje distinto por mes y año (2 decimales); tarifa anual distinta por año. 2026: mínimo 6 meses; 2027-2029: los 12 meses. Restricción R (mínimo/máximo mensual ofertado): 2026 50%, 2027 60%, 2028 85%, 2029 82%. Evaluación por año, de menor a mayor precio.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":17}}},{"nombre":"Producto 2","periodo_inicio":{"valor":"2026-01-01","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"periodo_fin":{"valor":"2040-12-31","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"horario":{"valor":"24 horas, todos los días","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"tipo_curva":"plana_24h","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"cantidad_resumen":{"valor":"32,452 GWh-producto en 2026-2040 (total 32,452,326,981 kWh); cantidades mensuales en el cuadro 4.2. Varía por año, sin total anual único.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":28}},"mwh_anual_citado":null,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Porcentaje de energía distinto de cero e igual para 2026-2029, y otro igual para 2030-2040 (2 decimales). Tarifa anual; si supera en más de 3% el precio reserva de algún año, la oferta no se evalúa. Evaluación de todo el producto por mérito de precio.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":18}}},{"nombre":"Producto 3","periodo_inicio":{"valor":"2026-01-01","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"periodo_fin":{"valor":"2040-12-31","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"horario":{"valor":"Tres bloques todos los días: B1 H01-H07, B2 H08-H17, B3 H18-H24","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"tipo_curva":"variable","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":12}},"cantidad_resumen":{"valor":"8,961 GWh-producto en 2026-2040 (total 8,960,903,634 kWh: B1 896,090,363; B2 4,480,451,817; B3 3,584,361,454 kWh); cantidades mensuales por bloque en el cuadro 4.3. Varía por año, sin total anual único.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":33}},"mwh_anual_citado":null,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Oferta por los tres bloques o por uno solo (no por dos). Con tres bloques, misma tarifa anual y mismo porcentaje en todos. El bloque ofertado debe ser el mismo todos los años; 0% solo permitido en 2026. Porcentaje igual por bloque en 2027-2029 y en 2030-2040. Se adjudican primero las ofertas de tres bloques y luego las de un bloque.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":19}}}],"precio":{"tope_o_reserva":{"valor":"Precio reserva (precio ponderado máximo por producto) fijado por Air-e y registrado en el SICEP el 2025-05-16; el pliego no publica su valor. Se aceptan precios anuales hasta 3% sobre la reserva de cada año si el precio ponderado de adjudicación no supera la reserva del producto.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":16}},"moneda_base":{"valor":"Pesos colombianos ($/kWh), constantes de abril de 2025, con dos decimales","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":15}},"indexacion":{"indice":{"valor":"IPP Oferta Interna provisional (DANE)","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":15}},"periodicidad":{"valor":"Mensual: P mes i = P abril 2025 x IPP mes i / IPP abril 2025","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":15}},"base":{"valor":"Abril de 2025","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":15}}}},"garantias":{"seriedad_oferta":{"valor":"Póliza de seguros (aseguradora con calificación mínima BAA1 Moody's, BBB+ Fitch o BBB BRC) o pagaré en blanco con carta de instrucciones; valor 1% del mayor valor anual de los productos ofertados, con impuestos; vigencia 60 días calendario desde la presentación de la oferta, ampliable hasta la firma de la oferta mercantil; original a Air-e a más tardar 2025-05-26 (2025-05-29 15:00 con guía de envío)","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":10}},"cumplimiento_contrato":{"valor":"Pagaré en blanco con carta de instrucciones más póliza de cumplimiento por el 3% del valor estimado del año a amparar, con impuestos; vigencia anual, entrega en 5 días hábiles tras aceptar la oferta mercantil y renovación al menos 30 días antes del siguiente año","fuente":{"archivo":"3.Modelo Oferta Mercantil CP-CSIC2025-002.docx","pagina":null}},"pago_comprador":{"valor":"Pagaré en blanco con carta de instrucciones más garantía del Fondo Nacional de Garantías o del Fondo Empresarial de la SSPD por 2,5 meses promedio de facturación por año, entregada 30 días antes del inicio; si no se obtiene, prepago semanal o mensual","fuente":{"archivo":"3.Modelo Oferta Mercantil CP-CSIC2025-002.docx","pagina":null}}},"criterio_adjudicacion":{"valor":"Menor precio por producto, ordenando ofertas de menor a mayor y adjudicando por mérito de precio, con energía adjudicada menor o igual a la de la oferta reserva y precio ponderado de adjudicación menor o igual al de reserva. Empates: prorrata de las cantidades ofertadas. Producto 3: primero ofertas de tres bloques.","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":16}},"penalidades":[{"valor":"Terminación anticipada por causales de la cláusula 13: la parte que incumple paga 5% del valor estimado de la oferta como pena, sin extinguir la obligación","fuente":{"archivo":"3.Modelo Oferta Mercantil CP-CSIC2025-002.docx","pagina":null}},{"valor":"Retraso del registro ante el ASIC por más de 15 días calendario por incumplimiento de una parte: paga a la otra la energía de los días de desplazamiento al precio del mes; pasados 15 días más, la parte cumplida puede terminar el contrato","fuente":{"archivo":"3.Modelo Oferta Mercantil CP-CSIC2025-002.docx","pagina":null}},{"valor":"Garantía de seriedad se hace efectiva si el adjudicatario revoca la oferta, no la firma sin justa causa, no constituye la garantía de cumplimiento o no cubre obligaciones con el MEM para registrar el contrato","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":10}},{"valor":"Incumplimiento por falta de suministro total o parcial durante 3 días consecutivos o 15 discontinuos por causa imputable al oferente; 5 días hábiles para subsanar antes de la terminación de pleno derecho","fuente":{"archivo":"3.Modelo Oferta Mercantil CP-CSIC2025-002.docx","pagina":null}},{"valor":"Limitación sobreviniente del proponente: Air-e puede terminar de pleno derecho sin indemnización y hacer efectiva la cláusula de sanción por incumplimiento","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":9}}],"fncer":{"exclusivo":false,"requisitos":{"valor":"Solo para ofertas respaldadas con FNCER: certificado UPME de inscripción del proyecto, garantía de conexión (CREG 075 de 2021), licencia ambiental (más de 10 MW) o permiso de aprovechamiento (menos de 10 MW) y estudio de factibilidad aprobado; plantas existentes: certificación de energía disponible; contratos bilaterales FNCER: certificación del representante legal","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":8}}},"condiciones_especiales":[{"valor":"Comprador en toma de posesión con fines liquidatorios: el contrato prevé cesión a las empresas de una eventual solución empresarial y garantías de pago con FNG o Fondo Empresarial de la SSPD","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":2}},{"valor":"Modalidad pague lo contratado; se puede adjudicar total o parcialmente y el precio ofertado es el mismo para cualquier cantidad adjudicada","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":11}},{"valor":"Air-e rechaza propuestas con precios o componentes no completamente determinados; prevalece el archivo Excel enviado sobre los demás","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":14}},{"valor":"No califican quienes hayan incumplido contratos con Air-e, se hayan abstenido sin justa causa de firmar, estén en liquidación o no estén registrados ante el ASIC","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":8}},{"valor":"Oferta irrevocable por 30 días hábiles desde el día siguiente a su presentación; los requisitos habilitantes se subsanan en 5 días hábiles","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":7}},{"valor":"Si ningún oferente habilitado queda dentro de la metodología o la oferta reserva, la convocatoria se declara desierta","fuente":{"archivo":"1. Pliegos de condiciones definitivas CP-CSIC2025-002.pdf","pagina":21}}],"resumen_ejecutivo":"Air-e S.A.S. E.S.P. (Intervenida, en liquidación con administración temporal) convocó la compra de energía y potencia para su mercado regulado entre 2026-01-01 y 2040-12-31 en tres productos, bajo la Resolución CREG 130 de 2019: Producto 1 de 10,710 GWh (2026-2029, 24 horas), Producto 2 de 32,452 GWh (2026-2040, 24 horas) y Producto 3 de 8,961 GWh (2026-2040, tres bloques horarios). El contrato es una oferta mercantil pague lo contratado con precios en pesos de abril de 2025 indexados mensualmente al IPP Oferta Interna, y el precio reserva no se publica en el pliego. Se adjudica por menor precio hasta la energía y el precio de reserva; el comprador respalda el pago con pagaré y garantía del FNG o del Fondo Empresarial de la SSPD. Según el estado en SICEP, la convocatoria está cerrada y desierta."},"modelo":"claude-code","alertas":[]}