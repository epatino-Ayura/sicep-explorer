hivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":11}}},"productos":[{"nombre":"Producto 1","periodo_inicio":{"valor":"2027-01-01","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":14}},"periodo_fin":{"valor":"2027-12-31","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":14}},"horario":{"valor":"H01–H24 todos los tipos de día (ordinario, sábado, domingo-festivo), siguiendo la curva de carga del pliego","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":14}},"tipo_curva":"variable","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":14}},"cantidad_resumen":{"valor":"337,212 MWh-año (337,212,330 kWh); curva horaria según tabla 9.1","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":14}},"mwh_anual_citado":337212,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Debe seguir la curva de carga solicitada; un solo % de energía y un solo precio para todos los meses; puede ofertarse menos del 100 % pero no 0 %; cantidades en kWh redondeadas a cero decimales.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":35}}},{"nombre":"Producto 2","periodo_inicio":{"valor":"2027-01-01","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":15}},"periodo_fin":{"valor":"2027-12-31","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":15}},"horario":{"valor":"H01–H24 todos los tipos de día (oferta plana)","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":15}},"tipo_curva":"plana_24h","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":15}},"cantidad_resumen":{"valor":"262,800 MWh por todo el producto; 30,000 kWh por hora (techo)","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":15}},"mwh_anual_citado":262800,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Solo ofertas planas: energía igual en todas las horas y meses, con un único precio y un único %; puede ofertarse entre más de 0 % y 100 %; techo de energía de 30,000 kWh por hora.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":35}}},{"nombre":"Producto 3","periodo_inicio":{"valor":"2029-01-01","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":16}},"periodo_fin":{"valor":"2029-12-31","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":16}},"horario":{"valor":"H01–H24 todos los tipos de día, siguiendo la curva de carga del pliego","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":16}},"tipo_curva":"variable","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":16}},"cantidad_resumen":{"valor":"450,000 MWh-año (449,999,891 kWh); curva horaria según tabla 9.3","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":16}},"mwh_anual_citado":450000,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Debe seguir la curva de carga solicitada; un solo % y un solo precio para todos los meses; puede ofertarse menos del 100 % pero no 0 %; kWh redondeados a cero decimales.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":35}}},{"nombre":"Producto 4","periodo_inicio":{"valor":"2027-01-01","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":17}},"periodo_fin":{"valor":"2040-12-31","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":17}},"horario":{"valor":"H07–H17 todos los tipos de día (curva solar)","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":17}},"tipo_curva":"variable","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":17}},"cantidad_resumen":{"valor":"700,000 MWh en total; 50,000 MWh por cada año 2027 a 2040","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":17}},"mwh_anual_citado":50000,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Exclusivo FNCER; un solo % de energía igual para todos los meses y años (redondeo a 2 decimales), no se acepta 0 %; se admiten precios distintos por año; se excluye la oferta que supere en más de 4 % el precio de reserva de algún año o el promedio ponderado de reserva.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":36}}}],"precio":{"tope_o_reserva":{"valor":"CENS fija un precio de reserva por producto y lo envía al ASIC hasta 2025-12-01; el pliego no publica el valor. En Productos 1 a 3 las ofertas por encima del precio de reserva no se evalúan; en Producto 4 se excluye la oferta con variación superior al 4 % en algún año frente a la reserva anual o que supere el promedio ponderado de reserva.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":34}},"moneda_base":{"valor":"Pesos colombianos por kWh (precio monomio, dos decimales), constantes de octubre de 2025","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":18}},"indexacion":{"indice":{"valor":"IPP serie Oferta Interna (DANE), versión provisional; no se evalúan ofertas con otros índices","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":18}},"periodicidad":{"valor":"Mensual: Precio mes = Precio base × IPP del mes / IPP de octubre de 2025","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":18}},"base":{"valor":"Octubre de 2025","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":18}}}},"garantias":{"seriedad_oferta":{"valor":"Póliza o garantía bancaria a favor de CENS por el 3 % del valor de la oferta asegurable (desviación máxima admitida del 20 % en el cálculo); vigente 45 días calendario desde el cierre de ofertas hasta la formalización y hasta el registro de la orden de compra ante el ASIC.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":21}},"cumplimiento_contrato":{"valor":"Póliza o garantía bancaria por el 3 % del valor en pesos corrientes del suministro aceptado (indexado con IPP); vigente durante todo el plazo más 90 días; entrega dentro de 5 días hábiles; puede darse en tramos sucesivos de 1 a 5 años.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":45}},"pago_comprador":{"valor":"CENS entrega un pagaré en blanco con carta de instrucciones dentro de 5 días hábiles siguientes a la formalización del negocio jurídico.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":45}}},"criterio_adjudicacion":{"valor":"Menor precio entre ofertas elegibles. Productos 1 a 3: se ordenan de menor a mayor precio; Producto 4: por promedio ponderado del precio de oferta, tras las exclusiones frente a la reserva. Se adjudica hasta la cantidad solicitada; el empate se resuelve por la oferta entregada con más anticipación al ASIC.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":36}},"penalidades":[{"valor":"Cláusula penal pecuniaria del 20 % de la energía adjudicada por suministrar multiplicada por el precio adjudicado actualizado con IPP, a cargo de la parte que incumpla o dé lugar a la terminación; es pago parcial y se pueden cobrar perjuicios adicionales demostrados.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":46}},{"valor":"Se hace efectiva la garantía de seriedad si el oferente modifica, adiciona o retira su oferta, no formaliza o no aporta los documentos en plazo, o no ajusta la garantía.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":21}},{"valor":"Si por causa del oferente aceptado no se registra la oferta mercantil y la orden de compra ante el ASIC, se hace efectiva la garantía de cumplimiento.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":41}},{"valor":"No constituir o renovar la garantía de cumplimiento con 3 meses de anticipación permite terminar el negocio jurídico sin requerimiento y cobrar la cláusula penal.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":45}},{"valor":"Si CENS paga tarde reconoce intereses a la tasa máxima legal moratoria certificada por la Superintendencia Financiera.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":48}},{"valor":"El oferente aceptado puede terminar el negocio si CENS no paga 2 cobros consecutivos de energía suministrada; el incumplimiento de una parte hace exigible la cláusula penal del 20 %.","fuente":{"archivo":"Oferta Mercantil CP CNSC2025-004.docx","pagina":null}}],"fncer":{"exclusivo":false,"requisitos":{"valor":"Solo el Producto 4 es exclusivo FNCER (fuentes del numeral 17 del art. 5 de la Ley 1715 de 2014); los Productos 1 a 3 aceptan todas las tecnologías. Para proyectos FNCER se exige certificado UPME de inscripción mínimo en fase 2 y que la fuente sea FNCER; si la energía viene de contratos bilaterales, carta del representante legal indicando partes y proyectos; se adjunta listado de plantas FNCER (Anexo 4).","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":31}}},"condiciones_especiales":[{"valor":"El oferente debe tener CROM1amt de venta igual o mayor a la energía ofertada en todos los meses, según la versión definitiva del ASIC del 2025-11-30; no se aceptan uniones temporales ni consorcios.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":31}},{"valor":"Modalidad Pague lo Contratado: los valores horarios de las tablas son topes, el % ofertado se aplica a la curva solicitada, solo se adjudica hasta el 100 % y las nuevas órdenes de compra no desplazan contratos existentes.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":13}},{"valor":"Producto 4: un solo % para todo el bloque 2027-2040 y precios que pueden variar por año, pero cada año no puede superar en más de 4 % la reserva anual.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":36}},{"valor":"Solo la garantía de seriedad y la oferta mercantil firmada son requisitos insubsanables; los demás se subsanan en hasta 5 días hábiles. No se aceptan cambios a la minuta de oferta mercantil.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":34}},{"valor":"Si la CREG expide regulación sobre el cumplimiento del negocio, el oferente aceptado debe presentar garantías adicionales que cubran ese riesgo.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":45}},{"valor":"El pago es a 30 días calendario del último día de suministro del mes, y CENS no paga hasta recibir el paz y salvo de seguridad social y parafiscales.","fuente":{"archivo":"PLIEGO DEFINITIVO CP CNSC2025-004.pdf","pagina":47}}],"resumen_ejecutivo":"CENS S.A. E.S.P. (Cúcuta) invitó a ofertar energía para su mercado regulado en cuatro productos bajo la modalidad Pague lo Contratado: Producto 1 de 337,212 MWh en 2027 con curva variable, Producto 2 plano de 262,800 MWh en 2027, Producto 3 de 450,000 MWh en 2029 con curva variable y Producto 4 exclusivo FNCER de 50,000 MWh por año de 2027 a 2040 (700,000 MWh) en horas 7 a 17. Los precios se ofertan en pesos de octubre de 2025 indexados mensualmente con el IPP Oferta Interna, y se comparan contra un precio de reserva no publicado. Cada vendedor da garantía de seriedad del 3 % y de cumplimiento del 3 % más 90 días, y CENS respalda el pago con pagaré en blanco; la cláusula penal es del 20 % de la energía faltante. Según el sistema SICEP la convocatoria está cerrada y adjudicada; el pliego programó la audiencia de adjudicación el 2025-12-15."},"modelo":"claude-code","alertas":[]}