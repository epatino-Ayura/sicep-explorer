a":3}},"adjudicacion":{"valor":"Audiencia pública de evaluación de resultados el 2025-11-04 a las 15:00 h; verificación de requisitos habilitantes el 2025-10-29","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":3}},"firma_contrato":{"valor":"Fecha máxima de suscripción 2025-11-24; fecha máxima de solicitud de registro 2025-11-28","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":3}}},"productos":[{"nombre":"Producto 1 - FNCER","periodo_inicio":{"valor":"2026-01-01 (el Anexo No. 8 indica 2027-01-01)","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"periodo_fin":{"valor":"2040-12-31","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"horario":{"valor":"Carga igual a la del Anexo No. 1: de 07 a 17 horas según la sección 6; de 07 a 18 horas, todos los días, según el Anexo No. 8","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":5}},"tipo_curva":"plana_franja","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"cantidad_resumen":{"valor":"Tamaño del contrato: 336,000 MWh/año (Anexo No. 8). Se ofrece un porcentaje de la curva del Anexo No. 1, con hasta dos decimales.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"mwh_anual_citado":336000,"pct_minimo_oferta":50,"reglas_oferta":{"valor":"Mínimo 50% para toda la vigencia, salvo 2027 y 2028 donde el mínimo es 10%. Se debe ofertar todos los años, con un precio anual. Solo se seleccionan ofertas por debajo del precio de reserva de cada año; se evalúa con el precio ponderado por la energía ofertada.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":5}}},{"nombre":"Producto 2 - Plano","periodo_inicio":{"valor":"2026-01-01","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"periodo_fin":{"valor":"2040-12-31","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"horario":{"valor":"24 horas del día, todos los días de todos los meses","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"tipo_curva":"plana_24h","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"cantidad_resumen":{"valor":"Tamaño del contrato: 2,247,781 MWh/año (Anexo No. 8). Porcentaje de la curva plana del Anexo No. 2: mensual en 2026 y anual de 2027 a 2040.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}},"mwh_anual_citado":2247781,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Sin oferta mínima. En 2026 se puede ofertar porcentaje y precio distintos por mes; de 2027 a 2040 un solo porcentaje y un precio anual. El precio no debe superar el precio de reserva (uno igual para los meses de 2026 y uno por año de 2027 a 2040).","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":6}}},{"nombre":"Producto 3 - Curva","periodo_inicio":{"valor":"2027-01-01","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":26}},"periodo_fin":{"valor":"2040-12-31","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":26}},"horario":{"valor":"24 horas del día, todos los días, siguiendo la curva de carga del Anexo No. 3","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":26}},"tipo_curva":"variable","tipo_contrato":{"valor":"Pague lo contratado","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":26}},"cantidad_resumen":{"valor":"Tamaño del contrato: 460,229 MWh/año (Anexo No. 8). Porcentaje anual de la curva del Anexo No. 3.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":26}},"mwh_anual_citado":460229,"pct_minimo_oferta":null,"reglas_oferta":{"valor":"Sin oferta mínima para 2027-2040. Un solo porcentaje y un precio anual por año; el precio no debe superar el precio de reserva de cada año.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":6}}}],"precio":{"tope_o_reserva":{"valor":"Existe precio de reserva (por año para el Producto 1 y por año 2027-2040 en los Productos 2 y 3; uno igual para los meses de 2026 en el Producto 2). El pliego no publica los valores; Electrohuila remite la oferta de reserva al ASIC el 2025-10-21.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":16}},"moneda_base":{"valor":"Pesos colombianos constantes de agosto de 2025, con dos decimales y precios fijos; incluyen impuestos y cargos a cargo del oferente.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":4}},"indexacion":{"indice":{"valor":"IPP Total Nacional serie oferta interna (DANE, versión provisional); fórmula Pi = Po x (IPPi / IPPo)","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":8}},"periodicidad":{"valor":"Actualización mensual del precio","fuente":{"archivo":"ANEXO No. 9 MINUTA DE CONTRATO- PAGARÉ EN BLANCO.docx","pagina":null}},"base":{"valor":"Agosto de 2025 (IPPo = 183,70, versión provisional, según la minuta)","fuente":{"archivo":"ANEXO No. 9 MINUTA DE CONTRATO- PAGARÉ EN BLANCO.docx","pagina":null}}}},"garantias":{"seriedad_oferta":{"valor":"Garantía bancaria o póliza de seguros; 1% del valor total de la propuesta (mínimo $20.000.000); vigencia de 90 días calendario desde el día siguiente al cierre; tomador el proponente, beneficiario Electrohuila.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":9}},"cumplimiento_contrato":{"valor":"Póliza o garantía bancaria por el 1% del valor estimado del suministro aceptado, entregada dentro de los 7 días hábiles siguientes a la firma; vigencia del contrato más 30 días, con emisión por anualidades (1 a 5 años). Además, pagaré en blanco con carta de instrucciones (Anexo No. 10).","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":18}},"pago_comprador":{"valor":"Electrohuila suscribe un pagaré en blanco con carta de instrucciones (Anexo No. 10) con la firma del contrato. Pago a 30 días calendario desde el último día de suministro del mes.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":20}}},"criterio_adjudicacion":{"valor":"Solo se evalúan ofertas con precio igual o inferior a la reserva. Entra primero el menor precio (Producto 1: menor precio ponderado por energía ofertada) hasta completar el 100% de la energía solicitada. Empates en precio: la energía se asigna a prorrata de la demanda.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":16}},"penalidades":[{"valor":"Cláusula penal pecuniaria: en caso de resolución o terminación por incumplimiento grave o definitivo, la parte incumplida paga 10% del valor estimado que falte por ejecutar; se pueden cobrar perjuicios en exceso.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":30}},{"valor":"Si el vendedor no suscribe el contrato, Electrohuila puede hacer efectiva la garantía de seriedad de la oferta, sin perjuicio de otras acciones.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":18}},{"valor":"Si el registro del contrato se retrasa por culpa del oferente (por ejemplo, plantillas firmadas tarde), se puede hacer efectiva la garantía de seriedad.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":18}},{"valor":"Retraso en el inicio por causa de una parte: paga a la otra la energía de los días de desplazamiento liquidada a la diferencia entre precio de bolsa (o de escasez si es menor) y el precio del contrato indexado; si es negativa no se cobra.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":28}},{"valor":"Terminación unilateral por incumplimiento en la entrega o en los mecanismos de cubrimiento del MEM: 5 días hábiles para subsanar; vencidos, el contrato termina de pleno derecho y se cobra la cláusula penal.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":30}}],"fncer":{"exclusivo":false,"requisitos":{"valor":"Solo el Producto 1 es FNCER: proyecto inscrito en UPME Fase II con factibilidad terminada, certificado UPME, garantía de conexión (CREG 075/2021) y licencia ambiental (más de 10 MW) o permiso de aprovechamiento (menos de 10 MW). Plantas existentes: certificación de la energía disponible descontando contratos previos, incluidas subastas 2 y 3 del MME. Energía de contratos bilaterales FNCER: certificación del representante legal.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":4}}},"condiciones_especiales":[{"valor":"No se admiten condiciones especiales de adjudicación (total, mínima u otras); las ofertas deben permitir una evaluación objetiva e integral.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":7}},{"valor":"Solo son insubsanables la carta de presentación y la garantía de seriedad (causal de rechazo); los demás requisitos se pueden subsanar en hasta 5 días hábiles. El original de la garantía debe llegar a Electrohuila máximo 3 días hábiles después del cierre.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":12}},{"valor":"Reclamaciones solo de forma verbal en la audiencia pública, antes de la adjudicación; después no se aceptan.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":17}},{"valor":"Solo pueden ofertar generadores o comercializadores inscritos en el SIC, o con proyectos registrados ante UPME con factibilidad terminada; la persona jurídica debe tener una duración superior en un año al período de suministro.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":2}},{"valor":"El pliego dice que las partes revisarán y podrán modificar el indexador según lo que requiera la CREG (riesgo regulatorio). Debida diligencia periódica: si no se mitigan los riesgos hallados, el contrato se suspende.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":8}},{"valor":"Inconsistencias del pliego: el Producto 1 figura con vigencia desde 2026 (sección 6 y anexos de oferta) y desde 2027 (Anexo No. 8); su horario es 07-17 h (sección 6) o 07-18 h (Anexo No. 8). Las curvas de los Anexos 1 a 6 no están en el texto disponible.","fuente":{"archivo":"PLIEGOS DEFINITIVOS CP-HLAC2025-002.pdf","pagina":25}}],"resumen_ejecutivo":"Electrohuila S.A. E.S.P. convocó la compra de energía para su mercado regulado del 1 de enero de 2026 al 31 de diciembre de 2040, en contratos pague lo contratado con tres productos: FNCER en franja diurna (336,000 MWh/año), plano 24 horas (2,247,781 MWh/año) y curva (460,229 MWh/año, desde 2027). Los precios se ofertan en pesos de agosto de 2025, indexados mensualmente por IPP oferta interna, y solo se adjudican ofertas por debajo de un precio de reserva no publicado en el pliego. Exige garantía de seriedad del 1% (mínimo $20 millones), garantía de cumplimiento del 1% y pagarés de ambas partes; la cláusula penal es del 10% del valor pendiente. La convocatoria figura en SICEP como cerrada y adjudicada; las ofertas se recibieron el 2025-10-21 y la audiencia fue el 2025-11-04."},"modelo":"claude-code","alertas":["Producto 1: período del resumen 2026-2040 vs SICEP 2027-2040"]}